# Copy to .env (never commit .env). Generate values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# API keys are stored ONLY as SHA-256 hashes:
#   python3 -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" "<your-api-key>"

ANAMIKA_ENV=production
ANAMIKA_MASTER_SECRET=change-me-48-random-chars
ANAMIKA_API_KEYS_SHA256=comma,separated,sha256,hashes
REDIS_PASSWORD=change-me-too

# Optional
API_PORT=8000
DATASETS_HOST_DIR=./datasets          # each dataset: <name>/input[/..] and optional <name>/truth/truth.json
ANAMIKA_CORS_ORIGINS=http://localhost:3000
ANAMIKA_TRUSTED_HOSTS=localhost,127.0.0.1,api
ANAMIKA_RATE_DEFAULT=120/minute
ANAMIKA_RATE_JOBS_CREATE=10/minute
ANAMIKA_RATE_DOWNLOADS=300/minute
ANAMIKA_JOB_TTL_HOURS=24
WORKER_CONCURRENCY=1
